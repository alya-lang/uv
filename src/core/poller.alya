# High-Level UvPoller Engine
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../types.alya"
import "../ffi.alya"

# Creates a new initialized UvPoller instance backed by kernel multiplexer
pub function poller_new(initial_capacity = 64, max_events_batch = 64)
    if initial_capacity is null or initial_capacity < 8
        initial_capacity = 8
    end
    if max_events_batch is null or max_events_batch < 8
        max_events_batch = 8
    end
    let handle = alya_uv_poller_create(initial_capacity)
    if handle is null
        return null
    end
    let ev_buf = alya_uv_events_create(max_events_batch)
    return UvPoller {
        handle: handle,
        events_buffer: ev_buf,
        buffer_capacity: max_events_batch,
        closed: 0
    }
end

# Registers a socket descriptor with the kernel poller
pub function poller_add(p, fd, events = 1, udata = 0)
    if p is null or p.closed == 1 or fd is null or fd < 0
        return -1
    end
    if events is null
        events = UvEvent.Readable
    end
    if udata is null
        udata = 0
    end
    return alya_uv_poller_add(p.handle, fd, events, udata)
end

# Modifies watched events for a registered socket
pub function poller_modify(p, fd, events, udata = 0)
    if p is null or p.closed == 1 or fd is null or fd < 0
        return -1
    end
    if udata is null
        udata = 0
    end
    return alya_uv_poller_modify(p.handle, fd, events, udata)
end

# Deregisters a socket descriptor from the kernel poller
pub function poller_remove(p, fd)
    if p is null or p.closed == 1 or fd is null or fd < 0
        return -1
    end
    return alya_uv_poller_remove(p.handle, fd)
end

# Polls the kernel multiplexer for ready I/O events up to timeout_ms
# Returns an array of UvEventNotification records
pub function poller_wait(p, timeout_ms = 100)
    if p is null or p.closed == 1
        return []
    end
    if timeout_ms is null or timeout_ms < 0
        timeout_ms = 0
    end
    let triggered_count = alya_uv_poller_wait(p.handle, p.events_buffer, p.buffer_capacity, timeout_ms)
    if triggered_count <= 0
        return []
    end

    let results = []
    let i = 0
    while i < triggered_count
        let fd = alya_uv_event_fd(p.events_buffer, i)
        let ev_flags = alya_uv_event_flags(p.events_buffer, i)
        let udata = alya_uv_event_udata(p.events_buffer, i)
        push(results, UvEventNotification(0, fd, ev_flags, udata))
        i += 1
    end
    return results
end

# Returns total active sockets monitored by this poller
pub function poller_count(p)
    if p is null or p.closed == 1
        return 0
    end
    return alya_uv_poller_count(p.handle)
end

# Closes the poller and frees native OS resources
pub function poller_close(p)
    if p is null or p.closed == 1
        return 0
    end
    p.closed = 1
    if p.events_buffer is not null
        alya_uv_events_free(p.events_buffer)
        p.events_buffer = null
    end
    if p.handle is not null
        alya_uv_poller_close(p.handle)
        p.handle = null
    end
    return 1
end

# Watches an OS process signal (SIGINT=2, SIGTERM=15, etc.) via the poller
pub function poller_watch_signal(p, signum, udata = 0)
    if p is null or p.closed == 1 or signum is null or signum <= 0
        return -1
    end
    if udata is null
        udata = 0
    end
    return alya_uv_poller_watch_signal(p.handle, signum, udata)
end

# Deregisters a signal watcher from the poller
pub function poller_unwatch_signal(p, signum)
    if p is null or p.closed == 1 or signum is null or signum <= 0
        return -1
    end
    return alya_uv_poller_unwatch_signal(p.handle, signum)
end

# --- Struct Methods on UvPoller ---

pub function UvPoller.add(self, fd, events = 1, udata = 0)
    return poller_add(self, fd, events, udata)
end

pub function UvPoller.modify(self, fd, events, udata = 0)
    return poller_modify(self, fd, events, udata)
end

pub function UvPoller.remove(self, fd)
    return poller_remove(self, fd)
end

pub function UvPoller.wait(self, timeout_ms = 100)
    return poller_wait(self, timeout_ms)
end

pub function UvPoller.watch_signal(self, signum, udata = 0)
    return poller_watch_signal(self, signum, udata)
end

pub function UvPoller.unwatch_signal(self, signum)
    return poller_unwatch_signal(self, signum)
end

pub function UvPoller.count(self)
    return poller_count(self)
end

pub function UvPoller.close(self)
    return poller_close(self)
end

# ═══════════════════════════════════════════════════════════════
# Windows IOCP / Universal Async Completion Queue
# ═══════════════════════════════════════════════════════════════

# Creates a new async I/O completion queue
pub function iocp_new(max_threads = 0)
    if max_threads is null or max_threads < 0
        max_threads = 0
    end
    let handle = alya_uv_iocp_create(max_threads)
    if handle is null
        return null
    end
    let ev_buf = alya_uv_events_create(16)
    return UvIocp {
        handle: handle,
        events_buffer: ev_buf,
        closed: 0
    }
end

# Associates a socket or file handle with the completion queue
pub function iocp_associate(iocp, socket_handle, completion_key = 0)
    if iocp is null or iocp.closed == 1 or socket_handle is null or socket_handle <= 0
        return -1
    end
    if completion_key is null
        completion_key = 0
    end
    return alya_uv_iocp_associate(iocp.handle, socket_handle, completion_key)
end

# Posts an asynchronous completion packet directly into the queue
pub function iocp_post(iocp, bytes_transferred, completion_key = 0, udata = 0)
    if iocp is null or iocp.closed == 1
        return -1
    end
    if bytes_transferred is null
        bytes_transferred = 0
    end
    if completion_key is null
        completion_key = 0
    end
    if udata is null
        udata = 0
    end
    return alya_uv_iocp_post(iocp.handle, bytes_transferred, completion_key, udata)
end

# Waits for a queued completion event up to timeout_ms
pub function iocp_wait(iocp, timeout_ms = 100)
    if iocp is null or iocp.closed == 1
        return []
    end
    if timeout_ms is null or timeout_ms < 0
        timeout_ms = 0
    end
    let res = alya_uv_iocp_wait(iocp.handle, iocp.events_buffer, 1, timeout_ms)
    if res <= 0
        return []
    end
    let key = alya_uv_event_fd(iocp.events_buffer, 0)
    let flags = alya_uv_event_flags(iocp.events_buffer, 0)
    let udata = alya_uv_event_udata(iocp.events_buffer, 0)
    return [UvEventNotification(0, key, flags, udata)]
end

# Closes the completion queue and frees resources
pub function iocp_close(iocp)
    if iocp is null or iocp.closed == 1
        return 0
    end
    iocp.closed = 1
    if iocp.events_buffer is not null
        alya_uv_events_free(iocp.events_buffer)
        iocp.events_buffer = null
    end
    if iocp.handle is not null
        alya_uv_iocp_close(iocp.handle)
        iocp.handle = null
    end
    return 1
end

# --- Struct Methods on UvIocp ---

pub function UvIocp.associate(self, socket_handle, completion_key = 0)
    return iocp_associate(self, socket_handle, completion_key)
end

pub function UvIocp.post(self, bytes_transferred, completion_key = 0, udata = 0)
    return iocp_post(self, bytes_transferred, completion_key, udata)
end

pub function UvIocp.wait(self, timeout_ms = 100)
    return iocp_wait(self, timeout_ms)
end

pub function UvIocp.close(self)
    return iocp_close(self)
end
