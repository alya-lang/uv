## # uv/core/poller
##
## High-level UvPoller engine.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Manages descriptor registration, readiness waits, signal watchers, and
## async completion queues over the native FFI layer.

import "../types.alya"
import "../ffi.alya"

## Creates an initialized `UvPoller` backed by the kernel multiplexer.
##
## Capacities below `8` are raised to the `8` minimum; null inputs fall
## back to the same floor.
##
## ### Parameters
## - `initial_capacity`: Pre-sized descriptor slots. Defaults to `64`.
## - `max_events_batch`: Maximum events per wait batch. Defaults to `64`.
##
## ### Returns
## The new `UvPoller` instance (null when native creation fails).
##
## ### Examples
## ```alya
## let p = poller_new(32, 32)
## ```
pub function poller_new(initial_capacity = 64, max_events_batch = 64)
    if initial_capacity is null or initial_capacity < 8
        initial_capacity = 8
    end
    if max_events_batch is null or max_events_batch < 8
        max_events_batch = 8
    end
    let handle = alya_uv_poller_create(initial_capacity)
    if handle is null
        return null
    end
    let ev_buf = alya_uv_events_create(max_events_batch)
    return UvPoller {
        handle: handle,
        events_buffer: ev_buf,
        buffer_capacity: max_events_batch,
        closed: 0
    }
end

## Registers a socket descriptor with the kernel poller.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
## - `fd`: Socket descriptor integer.
## - `events`: `UvEvent` bitmask. Defaults to `1` (`Readable`).
## - `udata`: Caller tag echoed back on events. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function poller_add(p: UvPoller, fd, events = 1, udata = 0) -> int
    if p is null or p.closed == 1 or fd is null or fd < 0
        return -1
    end
    if events is null
        events = UvEvent.Readable
    end
    if udata is null
        udata = 0
    end
    return alya_uv_poller_add(p.handle, fd, events, udata)
end

## Modifies watched events for a registered socket.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
## - `fd`: Socket descriptor integer.
## - `events`: Replacement `UvEvent` bitmask.
## - `udata`: Caller tag echoed back on events. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function poller_modify(p: UvPoller, fd, events: int, udata = 0) -> int
    if p is null or p.closed == 1 or fd is null or fd < 0
        return -1
    end
    if udata is null
        udata = 0
    end
    return alya_uv_poller_modify(p.handle, fd, events, udata)
end

## Deregisters a socket descriptor from the kernel poller.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
## - `fd`: Socket descriptor integer.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function poller_remove(p: UvPoller, fd) -> int
    if p is null or p.closed == 1 or fd is null or fd < 0
        return -1
    end
    return alya_uv_poller_remove(p.handle, fd)
end

## Polls the kernel multiplexer for ready I/O events up to a timeout.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
## - `timeout_ms`: Wait ceiling in milliseconds. Defaults to `100`.
##
## ### Returns
## Array of `UvEventNotification` records (possibly empty).
pub function poller_wait(p: UvPoller, timeout_ms = 100) -> array
    if p is null or p.closed == 1
        return []
    end
    if timeout_ms is null or timeout_ms < 0
        timeout_ms = 0
    end
    let triggered_count = alya_uv_poller_wait(p.handle, p.events_buffer, p.buffer_capacity, timeout_ms)
    if triggered_count <= 0
        return []
    end

    let results = []
    let i = 0
    while i < triggered_count
        let fd = alya_uv_event_fd(p.events_buffer, i)
        let ev_flags = alya_uv_event_flags(p.events_buffer, i)
        let udata = alya_uv_event_udata(p.events_buffer, i)
        push(results, UvEventNotification { kind: 0, fd: fd, events: ev_flags, udata: udata })
        i += 1
    end
    return results
end

## Returns the total active sockets monitored by this poller.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
##
## ### Returns
## Monitored descriptor count (`0` when closed).
pub function poller_count(p: UvPoller) -> int
    if p is null or p.closed == 1
        return 0
    end
    return alya_uv_poller_count(p.handle)
end

## Closes the poller and frees native OS resources (idempotent).
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
##
## ### Returns
## `1` on close, `0` when already closed.
pub function poller_close(p: UvPoller) -> int
    if p is null or p.closed == 1
        return 0
    end
    p.closed = 1
    if p.events_buffer is not null
        alya_uv_events_free(p.events_buffer)
        p.events_buffer = null
    end
    if p.handle is not null
        alya_uv_poller_close(p.handle)
        p.handle = null
    end
    return 1
end

## Watches an OS process signal (`SIGINT=2`, `SIGTERM=15`) via the poller.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
## - `signum`: Signal number integer.
## - `udata`: Caller tag echoed back on events. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function poller_watch_signal(p: UvPoller, signum, udata = 0) -> int
    if p is null or p.closed == 1 or signum is null or signum <= 0
        return -1
    end
    if udata is null
        udata = 0
    end
    return alya_uv_poller_watch_signal(p.handle, signum, udata)
end

## Deregisters a signal watcher from the poller.
##
## ### Parameters
## - `p`: Target `UvPoller` instance.
## - `signum`: Signal number integer.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function poller_unwatch_signal(p: UvPoller, signum) -> int
    if p is null or p.closed == 1 or signum is null or signum <= 0
        return -1
    end
    return alya_uv_poller_unwatch_signal(p.handle, signum)
end

