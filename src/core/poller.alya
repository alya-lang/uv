# ═══════════════════════════════════════════════════════════════
# Windows IOCP / Universal Async Completion Queue
# ═══════════════════════════════════════════════════════════════

## Creates a new async I/O completion queue.
##
## ### Parameters
## - `max_threads`: Worker thread hint (`0` selects a default). Defaults to `0`.
##
## ### Returns
## The new `UvIocp` instance (null when native creation fails).
pub function iocp_new(max_threads = 0)
    if max_threads is null or max_threads < 0
        max_threads = 0
    end
    let handle = alya_uv_iocp_create(max_threads)
    if handle is null
        return null
    end
    let ev_buf = alya_uv_events_create(16)
    return UvIocp {
        handle: handle,
        events_buffer: ev_buf,
        closed: 0
    }
end

## Associates a socket or file handle with the completion queue.
##
## ### Parameters
## - `iocp`: Target `UvIocp` instance.
## - `socket_handle`: Socket or file handle integer.
## - `completion_key`: Key echoed back on completion. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function iocp_associate(iocp, socket_handle, completion_key = 0) -> int
    if iocp is null or iocp.closed == 1 or socket_handle is null or socket_handle <= 0
        return -1
    end
    if completion_key is null
        completion_key = 0
    end
    return alya_uv_iocp_associate(iocp.handle, socket_handle, completion_key)
end

## Posts an asynchronous completion packet directly into the queue.
##
## ### Parameters
## - `iocp`: Target `UvIocp` instance.
## - `bytes_transferred`: Byte count reported with the packet.
## - `completion_key`: Key echoed back on completion. Defaults to `0`.
## - `udata`: Caller tag echoed back on completion. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function iocp_post(iocp, bytes_transferred, completion_key = 0, udata = 0) -> int
    if iocp is null or iocp.closed == 1
        return -1
    end
    if bytes_transferred is null
        bytes_transferred = 0
    end
    if completion_key is null
        completion_key = 0
    end
    if udata is null
        udata = 0
    end
    return alya_uv_iocp_post(iocp.handle, bytes_transferred, completion_key, udata)
end

## Waits for a queued completion event up to a timeout.
##
## ### Parameters
## - `iocp`: Target `UvIocp` instance.
## - `timeout_ms`: Wait ceiling in milliseconds. Defaults to `100`.
##
## ### Returns
## Single-element `UvEventNotification` array (empty on timeout).
pub function iocp_wait(iocp, timeout_ms = 100) -> array
    if iocp is null or iocp.closed == 1
        return []
    end
    if timeout_ms is null or timeout_ms < 0
        timeout_ms = 0
    end
    let res = alya_uv_iocp_wait(iocp.handle, iocp.events_buffer, 1, timeout_ms)
    if res <= 0
        return []
    end
    let key = alya_uv_event_fd(iocp.events_buffer, 0)
    let flags = alya_uv_event_flags(iocp.events_buffer, 0)
    let udata = alya_uv_event_udata(iocp.events_buffer, 0)
    return [UvEventNotification { kind: 0, fd: key, events: flags, udata: udata }]
end

## Closes the completion queue and frees resources (idempotent).
##
## ### Parameters
## - `iocp`: Target `UvIocp` instance.
##
## ### Returns
## `1` on close, `0` when already closed.
pub function iocp_close(iocp) -> int
    if iocp is null or iocp.closed == 1
        return 0
    end
    iocp.closed = 1
    if iocp.events_buffer is not null
        alya_uv_events_free(iocp.events_buffer)
        iocp.events_buffer = null
    end
    if iocp.handle is not null
        alya_uv_iocp_close(iocp.handle)
        iocp.handle = null
    end
    return 1
end

# ───────────────────────────────────────────────────────────────
# Struct Methods on UvIocp
# ───────────────────────────────────────────────────────────────

## Associates a socket or file handle with this queue.
##
## ### Parameters
## - `self`: The target `UvIocp` instance.
## - `socket_handle`: Socket or file handle integer.
## - `completion_key`: Key echoed back on completion. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function UvIocp.associate(self, socket_handle, completion_key = 0) -> int
    return iocp_associate(self, socket_handle, completion_key)
end

## Posts an asynchronous completion packet into this queue.
##
## ### Parameters
## - `self`: The target `UvIocp` instance.
## - `bytes_transferred`: Byte count reported with the packet.
## - `completion_key`: Key echoed back on completion. Defaults to `0`.
## - `udata`: Caller tag echoed back on completion. Defaults to `0`.
##
## ### Returns
## Native result code (`0` on success, `-1` on invalid input).
pub function UvIocp.post(self, bytes_transferred, completion_key = 0, udata = 0) -> int
    return iocp_post(self, bytes_transferred, completion_key, udata)
end

## Waits for a queued completion event up to a timeout.
##
## ### Parameters
## - `self`: The target `UvIocp` instance.
## - `timeout_ms`: Wait ceiling in milliseconds. Defaults to `100`.
##
## ### Returns
## Single-element `UvEventNotification` array (empty on timeout).
pub function UvIocp.wait(self, timeout_ms = 100) -> array
    return iocp_wait(self, timeout_ms)
end

## Closes this completion queue and frees resources.
##
## ### Parameters
## - `self`: The target `UvIocp` instance.
##
## ### Returns
## `1` on close, `0` when already closed.
pub function UvIocp.close(self) -> int
    return iocp_close(self)
end
