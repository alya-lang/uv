# Data structures and enums for uv kernel multiplexer
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Public enumeration for multiplexed socket I/O events
pub enum UvEvent
    Readable = 1,
    Writable = 2,
    Error = 4,
    Hangup = 8
end

# Event record triggered by the kernel poller
pub struct UvEventNotification
    fd,
    events,
    udata
end

# Poller struct wrapping native kernel multiplexer state
pub struct UvPoller
    handle,
    events_buffer,
    buffer_capacity,
    closed
end

# Human-readable event description formatter
pub function uv_event_name(events)
    let parts = []
    if (events & UvEvent.Readable) != 0
        push(parts, "READABLE")
    end
    if (events & UvEvent.Writable) != 0
        push(parts, "WRITABLE")
    end
    if (events & UvEvent.Error) != 0
        push(parts, "ERROR")
    end
    if (events & UvEvent.Hangup) != 0
        push(parts, "HANGUP")
    end
    if len(parts) == 0
        return "NONE"
    end
    let res = ""
    for i, p in parts
        if i > 0
            res += "|"
        end
        res += p
    end
    return res
end
