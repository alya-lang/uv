# demo.alya - Interactive showcase of uv kernel multiplexer
import "std/net"
import "../src/lib.alya" as uv

function main()
    say "=== Alya uv Kernel Multiplexer Showcase ==="
    say "OS Backend: " + uv::backend_name()
    say ""

    let p = uv::poller()
    say "1. Initialized UvPoller handle"

    let port = 19890
    let srv = tcp_listen(port, 5)
    tcp_set_nonblocking(srv, 1)
    p.add(srv, uv::UvEvent.Readable, 42)
    say "2. Listening on port " + str(port) + " and registered with poller"

    # Connect client
    let client = tcp_connect("127.0.0.1", port)
    say "3. Client connected from 127.0.0.1"

    # Wait for listener notification
    let evs = p.wait(50)
    say "4. Poller detected " + str(len(evs)) + " ready event(s)"

    if len(evs) > 0
        let accepted = tcp_accept(srv)
        tcp_set_nonblocking(accepted, 1)
        p.add(accepted, uv::UvEvent.Readable, 100)

        tcp_send(client, "HELLO_FROM_UV_CLIENT\n")
        let data_evs = p.wait(50)
        say "5. Poller detected incoming data on socket: " + str(len(data_evs)) + " event(s)"

        let msg = tcp_recv(accepted, 1024)
        say "   Server received: " + msg

        p.remove(accepted)
        p.remove(srv)
        tcp_close(client)
        tcp_close(accepted)
        tcp_close(srv)
    end

    p.close()
    say "6. Poller closed and native memory freed"
    say "\n🎉 uv demonstration completed successfully!"
end

main()
