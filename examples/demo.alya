## Demo of the uv kernel multiplexer
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/net"
import "../src/lib.alya" as uv

function main()
    say "=================================================="
    say "   Alya uv Kernel I/O Multiplexer Showcase"
    say "=================================================="
    let backend = uv::backend_name()
    say "Detected OS Kernel Backend: {backend}"
    say ""

    # 1. Poller Initialization
    say "--- 1. Initializing UvPoller Handle ---"
    let p = uv::poller(32, 32)
    say "✓ Poller created with capacity 32"
    let initial_count = p.count()
    say "• Initial monitored sockets: {initial_count}"
    say ""

    # 2. Server Setup & Poller Registration
    say "--- 2. Registering Non-Blocking TCP Server ---"
    let port = 19890
    let srv = tcp_listen(port, 5)
    tcp_set_nonblocking(srv, 1)
    p.add(srv, uv::UvEvent.Readable, 1001)
    say "✓ Server listening on 127.0.0.1:{port} (fd={srv})"
    say "✓ Registered listener with poller (udata=1001, events=READABLE)"
    let reg_count = p.count()
    say "• Monitored sockets count: {reg_count}"
    say ""

    # 3. Client Connection & Event Detection
    say "--- 3. Client Connection & Readiness Demultiplexing ---"
    let client = tcp_connect("127.0.0.1", port)
    say "✓ Client connected from 127.0.0.1 (fd={client})"

    let evs = p.wait(50)
    let ev_count = len(evs)
    say "✓ Poller wait detected {ev_count} ready event(s):"
    for ev in evs
        let ev_str = uv::uv_event_name(ev.events)
        say "  • Event on fd={ev.fd} | Type: {ev_str} | udata={ev.udata}"
    end
    say ""

    # 4. Accept & Data Exchange
    say "--- 4. Socket Accept & Non-Blocking Data Transmission ---"
    let accepted = tcp_accept(srv)
    tcp_set_nonblocking(accepted, 1)
    p.add(accepted, uv::UvEvent.Readable, 2002)
    say "✓ Accepted client connection (fd={accepted}, udata=2002)"

    tcp_send(client, "HELLO_KERNEL_MULTIPLEXER\n")
    say "✓ Sent 25-byte payload from client"

    let data_evs = p.wait(50)
    say "✓ Poller detected incoming data:"
    for ev in data_evs
        let ev_str = uv::uv_event_name(ev.events)
        say "  • Event on fd={ev.fd} | Type: {ev_str} | udata={ev.udata}"
    end

    let msg = tcp_recv(accepted, 1024)
    say "✓ Server received payload: {msg}"

    # 5. Modifying and Removing Sockets
    say "--- 5. Dynamic Event Modification & Deregistration ---"
    p.modify(accepted, uv::UvEvent.Writable, 3003)
    say "✓ Modified accepted socket event mask to WRITABLE (udata=3003)"

    p.remove(accepted)
    say "✓ Removed accepted socket from poller"
    let after_one = p.count()
    say "• Monitored sockets count: {after_one}"

    p.remove(srv)
    say "✓ Removed server listener from poller"
    let after_all = p.count()
    say "• Monitored sockets count: {after_all}"
    say ""

    # 6. Cleanup
    say "--- 6. Resource Cleanup ---"
    tcp_close(client)
    tcp_close(accepted)
    tcp_close(srv)
    p.close()
    say "✓ All sockets closed and native poller memory released."
    say ""
    say "=================================================="
    say "🎉 uv demonstration completed successfully!"
    say "=================================================="
end

main()
